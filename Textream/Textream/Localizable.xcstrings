      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "程度"
          }
        }
      }
    },
    "Anchored below the notch at the top of your screen.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挂在屏幕顶部的刘海下面，多行显示。"
