      }
    },
    "Separate source line breaks with extra space and three centered dots.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原稿换行的地方多留一点空，并用三个点隔开。"
          }
