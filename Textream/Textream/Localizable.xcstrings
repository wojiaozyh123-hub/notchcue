        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "靠上"
          }
        }
      }
    },
    "Near Top keeps the previous line visible above the active line.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「靠上」会把上一行留在当前行的上方。"
