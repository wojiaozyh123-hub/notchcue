    "Target Display": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标显示器"
          }
        }
      }
    },
    "Teleprompter": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提词显示"
          }
        }
      }
    },
    "The next word to read stays right under the camera.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一个要读的字固定在摄像头正下方。"
          }
        }
      }
    },
    "The notch moves to whichever display your mouse is on.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鼠标在哪块屏幕上，提词就显示在哪块。"
          }
        }
      }
    },
    "The notch stays on the selected display.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一直显示在选定的显示器上。"
          }
        }
      }
    },
    "The window follows your cursor and sticks to its bottom-right.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口跟着鼠标走，贴在鼠标右下方。"
          }
        }
      }
    },
    "This will restore all settings to their defaults.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有设置都会恢复成默认值。"
          }
        }
      }
    },
    "Tracks each word you say and highlights it in real time.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟着你说的每个字实时往前走。"
          }
        }
      }
    },
    "Transparency": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "半透明"
          }
        }
      }
    },
    "Uses ports %@ (HTTP) and %@ (WebSocket).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用端口 %1$@（HTTP）和 %2$@（WebSocket）。"
