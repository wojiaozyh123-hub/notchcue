    "Scan the QR code or open the URL with your iPhone, Android or TV browser on the same Wi-Fi network.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连在同一个 Wi-Fi 下，用 iPhone、安卓手机或电视的浏览器扫二维码，或者打开这个网址。"
          }
        }
      }
    },
    "Scroll Speed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滚动速度"
          }
        }
      }
    },
    "Scrolls while you speak, pauses when you're silent.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说话时滚动，不说话就停下。"
          }
