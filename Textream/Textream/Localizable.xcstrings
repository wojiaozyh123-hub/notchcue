    "Director Mode lets a remote person control your teleprompter script in real-time via a web browser. The editor will be disabled while active.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导演模式让另一个人用浏览器实时修改你的提词稿。开启期间，这边的编辑器不能用。"
          }
        }
      }
    },
    "Display": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示器"
          }
        }
      }
    },
    "Display a running timer while the teleprompter is active.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提词时显示已经用了多长时间。"
          }
        }
      }
    },
    "Display recently recognized words while using Word Tracking.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逐字跟随时，显示刚识别到的话。"
